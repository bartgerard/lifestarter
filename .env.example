# Copy to `.env` and adjust. `.env` is git-ignored; never commit real credentials.
#
#   cp .env.example .env
#   docker compose up -d --build

# Host port the site is published on. http://localhost:<port>
LIFESTARTER_HTTP_PORT=8080

# Where the RSVP data lives.
#   sqlite   – a file on the lifestarter-data volume, zero setup (default)
#   mongodb  – needs `docker compose --profile mongodb up -d`
LIFESTARTER_PERSISTENCE_TYPE=sqlite

# Storage for the SQLite database.
# Unset -> the named Docker volume `lifestarter-data` (survives `docker compose down`).
# Set it to a path (e.g. ./data or /srv/lifestarter/data) to use a host bind mount instead; the
# directory must be writable by uid 10001 — see "Where the data lives" in the README.
#LIFESTARTER_DATA=./data

# The only protected endpoint is the .xlsx export. Leave the password empty and the backend
# generates a random one and logs it at start-up (`docker compose logs server`).
LIFESTARTER_SECURITY_ADMIN_USERNAME=admin
LIFESTARTER_SECURITY_ADMIN_PASSWORD=

# MongoDB mode only. `mongo` is the compose service; point it elsewhere for an external server.
LIFESTARTER_MONGODB_URI=mongodb://mongo:27017
LIFESTARTER_MONGODB_DATABASE=lifestarter

# Confirmation e-mail. Skipped entirely while SPRING_MAIL_HOST is empty.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

TZ=Europe/Brussels
