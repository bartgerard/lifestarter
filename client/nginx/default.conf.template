# The Angular bundle plus a reverse proxy in front of the Spring Boot API.
#
# Serving both from the same origin is the whole point: the browser only ever talks to this server,
# so no CORS pre-flight, no cookie/origin juggling, and the backend never needs to be published.
#
# ${API_UPSTREAM} is substituted by the nginx entrypoint at container start.

server {
    listen      80;
    listen      [::]:80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS. Resolving the backend per request rather than once at start-up means a
    # restarted API container (which gets a new IP) does not leave nginx holding a stale address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options        SAMEORIGIN always;
    add_header Referrer-Policy        strict-origin-when-cross-origin always;
    # NOTE: any location below that declares its own add_header must repeat these; see
    # security-headers.inc.

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css application/javascript application/json
                    application/xml image/svg+xml font/woff font/woff2;

    # --- API ------------------------------------------------------------------------------------

    # Server-sent events. Without these the feed sits in nginx's buffer and the browser sees
    # nothing until the connection closes half an hour later.
    location = /api/events/stream {
        include /etc/nginx/snippets/proxy.inc;
        proxy_set_header Connection '';
        proxy_pass $api_upstream$request_uri;

        proxy_buffering           off;
        proxy_cache               off;
        proxy_read_timeout        1h;
        chunked_transfer_encoding off;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy.inc;
        proxy_pass $api_upstream$request_uri;

        # The .xlsx export streams; let it take its time.
        proxy_read_timeout 120s;
    }

    # Liveness/readiness for whatever sits in front of this container. Everything under /actuator
    # other than health and info is ADMIN-only in the backend itself.
    location /actuator/ {
        include /etc/nginx/snippets/proxy.inc;
        proxy_pass $api_upstream$request_uri;
    }

    location ~ ^/(v3/api-docs|swagger-ui) {
        include /etc/nginx/snippets/proxy.inc;
        proxy_pass $api_upstream$request_uri;
    }

    # --- Single page application ----------------------------------------------------------------

    # The Angular CLI fingerprints its bundles, so they can be cached forever.
    location ~* \.(?:js|css|woff2?|ttf|eot|otf|svg|png|jpe?g|gif|ico|webp)$ {
        include    /etc/nginx/snippets/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files  $uri =404;
    }

    # index.html is the one file that must never be cached, or a deploy is invisible until the
    # browser gives up on it.
    location = /index.html {
        include    /etc/nginx/snippets/security-headers.inc;
        add_header Cache-Control "no-store";
    }

    # The Angular router owns client-side paths: hand unknown paths the index page, not a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
